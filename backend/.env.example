# ---------------------------------------------------------------
# 使用方式：复制为 .env 后按实际环境修改
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
# ---------------------------------------------------------------

# ---------------- 应用 ----------------
APP_NAME=FleetPartsSystem
# development / testing / production
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8080
# API 统一前缀
API_V1_PREFIX=/api/v1

# ---------------- 数据库（MySQL 5.7 / 8.0） ----------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=fleet_parts
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# 是否打印 SQL 语句（调试用）
DB_ECHO=false

# ---------------- JWT ----------------
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------- 文件存储 ----------------
UPLOAD_DIR=./uploads
QRCODE_DIR=./uploads/qrcode
BARCODE_DIR=./uploads/barcode

# ---------------- 跨域（多个用英文逗号分隔） ----------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------- 日志 ----------------
# TRACE / DEBUG / INFO / SUCCESS / WARNING / ERROR
LOG_LEVEL=INFO
LOG_DIR=./logs
